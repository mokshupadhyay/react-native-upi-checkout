{
  "name": "react-native-upi-checkout",
  "version": "0.1.1",
  "description": "Start a UPI payment from a React Native app in India and read the result the UPI app returns. Typed URL building, validation and response parsing, installed UPI app detection, and one API on the old and the New Architecture.",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "author": "Moksh Upadhyay <mokshupadhyay4@gmail.com>",
  "homepage": "https://github.com/mokshupadhyay/react-native-upi-checkout#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mokshupadhyay/react-native-upi-checkout.git"
  },
  "bugs": {
    "url": "https://github.com/mokshupadhyay/react-native-upi-checkout/issues"
  },
  "files": [
    "src",
    "lib",
    "android/build.gradle",
    "android/src",
    "ios",
    "react-native-upi-checkout.podspec",
    "react-native.config.js",
    "!**/__tests__",
    "!**/*.test.ts",
    "!**/*.test.tsx",
    "!**/*.map"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "check": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "keywords": [
    "react-native",
    "upi",
    "upi-payment",
    "upi-intent",
    "india",
    "payments",
    "checkout",
    "npci",
    "bhim",
    "turbo-module",
    "new-architecture"
  ],
  "license": "MIT",
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-native": ">=0.60.0"
  },
  "codegenConfig": {
    "name": "RNUpiCheckoutSpec",
    "type": "modules",
    "jsSrcsDir": "src/specs",
    "android": {
      "javaPackageName": "com.upicheckout"
    }
  },
  "devDependencies": {
    "@react-native/babel-preset": "^0.88.0",
    "@react-native/jest-preset": "^0.88.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.3.0",
    "jest": "^29.7.0",
    "react": "^19.3.1",
    "react-native": "^0.88.0",
    "react-test-renderer": "^19.3.1",
    "typescript": "^5.9.3"
  }
}
